{
  "name": "teamhub",
  "productName": "TeamHub",
  "version": "1.2.1",
  "description": "TeamHub - 팀 정보공유 프로그램",
  "author": "TeamHub",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "plugins:builtin": "node scripts/build-plugins.mjs resources/plugins && node scripts/build-feedback.mjs",
    "dev": "pnpm plugins:builtin && electron-vite dev",
    "dev:b": "pnpm plugins:builtin && cross-env TEAMHUB_PROFILE=b electron-vite dev",
    "build": "pnpm plugins:builtin && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder --win --x64",
    "e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "release": "node scripts/release.mjs",
    "plugins:pack": "node scripts/build-plugins.mjs release/plugins"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.8",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.1",
    "systeminformation": "^5.33.19",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-details": "3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "playwright-core": "^1.65.0",
    "pretendard": "^1.3.9",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
